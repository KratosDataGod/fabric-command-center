# Copy to rayfin/.env (never committed) and fill in your semantic model's IDs.
# Find them in the model's Fabric URL: /groups/<workspace id>/datasets/<item id>/...
# or run: npx rayfin connector search "<model name>" --type fabric-semanticmodel --all-workspaces --json
FCC_MODEL_WORKSPACE_ID=
FCC_MODEL_ITEM_ID=
